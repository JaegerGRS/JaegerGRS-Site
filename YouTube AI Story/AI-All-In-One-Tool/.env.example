# Keep this file as a template only. Put real values in a local .env file.

# Create a Google Cloud project, enable YouTube Data API v3, then create an API key.
YOUTUBE_API_KEY=

# Google does not offer a general public Google Trends API. SerpApi is a
# supported provider option for Google Trends data.
GOOGLE_TRENDS_PROVIDER=serpapi
SERPAPI_KEY=

# Optional local text-generation configuration.
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434